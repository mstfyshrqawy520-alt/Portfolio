# 1. Google Cloud Drive API v3 Key (Server-side only, never exposed to client)
GOOGLE_API_KEY="AIzaSyYourRestrictedGoogleDriveApiKeyHere"

# 2. Google Drive Root Folder ID (Shared as "Anyone with the link – Viewer")
DRIVE_FOLDER_ID="10jSZM8JUKCd08C4R-TL3q57cbDj9GKE7"

# 3. Master Password for /admin sync dashboard
ADMIN_PASSWORD="ChooseAStrongAdminPasswordHere123!"

# 4. Secret token to authorize on-demand revalidation POST /api/revalidate
REVALIDATE_SECRET="super-secret-revalidation-key-random-string"

# 5. Public Site URL for SEO, Canonical URLs, and OpenGraph tags
NEXT_PUBLIC_SITE_URL="https://abdo-owais.com"
